{"noir_version":"1.0.0-beta.7+24c053fba747770cf8d3f813d22cfa003714dfb6","hash":"775116351189006980","abi":{"parameters":[{"name":"x","type":{"kind":"string","length":57},"visibility":"private"},{"name":"yp","type":{"kind":"string","length":10},"visibility":"public"},{"name":"y","type":{"kind":"string","length":10},"visibility":"public"}],"return_type":null,"error_types":{"6205006668095915909":{"error_kind":"string","string":"Public input y does not match expected value."},"16292203451551561274":{"error_kind":"string","string":"Substring verification has failed."}}},"bytecode":"","debug_symbols":"","file_map":{"50":{"source":"global STRSIZE: u32 = 57;\nglobal SUBSTRSIZE: u32 = 10;\n\nfn contains(string: str<STRSIZE>, substring: str<SUBSTRSIZE>) -> bool {\n    let string_bytes = string.as_bytes();\n    let substring_bytes = substring.as_bytes();\n    let string_len = 57;\n    let substring_len = 10;\n\n    let mut found = false;\n\n    for i in 0..(string_len - substring_len + 1) {\n        let mut match_found = true;\n        for j in 0..substring_len {\n            if string_bytes[i + j] != substring_bytes[j] {\n                match_found = false;\n            }\n        }\n        if match_found {\n            found = true;\n        }\n    }\n\n    found\n}\n\nfn main(x: str<STRSIZE>, yp: pub str<SUBSTRSIZE>, y: pub str<SUBSTRSIZE>) {\n    // First step: check that public inputs are correct\n    assert(y == yp, \"Public input y does not match expected value.\");\n    // Second step: check if x contains y\n    assert(contains(x, y), \"Substring verification has failed.\");\n}\n\n#[test]\nfn test_main() {\n    // Test that it passes substring verification\n    main(\n        \"42 Fictional Way, Smithfield, Dublin 7, D07 F4K3, Ireland\",\n        \"Smithfield\",\n        \"Smithfield\",\n    );\n}\n","path":"/Users/ribeiro/Repositories/DISSECT/verifiable-zkp/implementations/base/str/src/main.nr"}},"names":["main"],"brillig_names":["directive_invert"]}