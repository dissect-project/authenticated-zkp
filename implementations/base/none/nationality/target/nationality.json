{"noir_version":"1.0.0-beta.7+24c053fba747770cf8d3f813d22cfa003714dfb6","hash":"15066528103109054410","abi":{"parameters":[{"name":"list","type":{"kind":"array","length":5,"type":{"kind":"string","length":2}},"visibility":"private"},{"name":"nationalityp","type":{"kind":"string","length":2},"visibility":"public"},{"name":"nationality","type":{"kind":"string","length":2},"visibility":"public"}],"return_type":null,"error_types":{"6794442214255235164":{"error_kind":"string","string":"Public input nationality does not match expected value."},"15512394517384629053":{"error_kind":"string","string":"Nationality is not in the list."}}},"bytecode":"","debug_symbols":"","file_map":{"50":{"source":"global Nationalities: u32 = 5; // Maximum number of allowed nationalities\n\nfn main(list: [str<2>; Nationalities], nationalityp: pub str<2>, nationality: pub str<2>) {\n    // First step: check that public inputs are correct\n    assert(nationality == nationalityp, \"Public input nationality does not match expected value.\");\n    // Second step: check if nationality is in the list\n    let mut found = false;\n    for i in 0..Nationalities {\n        if (list[i].as_bytes()[0] == nationality.as_bytes()[0])\n            & (list[i].as_bytes()[1] == nationality.as_bytes()[1]) {\n            found = true;\n        }\n    }\n    assert(found, \"Nationality is not in the list.\");\n}\n\n#[test]\nfn test_main() {\n    // Test that it passes list verification\n    main([\"PT\", \"EN\", \"--\", \"--\", \"--\"], \"PT\", \"PT\");\n}\n","path":"/Users/ribeiro/Repositories/DISSECT/verifiable-zkp/implementations/base/nationality/src/main.nr"}},"names":["main"],"brillig_names":["directive_invert"]}