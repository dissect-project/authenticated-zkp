{"noir_version":"1.0.0-beta.7+24c053fba747770cf8d3f813d22cfa003714dfb6","hash":"11584672385131704881","abi":{"parameters":[{"name":"dob","type":{"kind":"array","length":10,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"private"},{"name":"todayp","type":{"kind":"array","length":10,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"private"},{"name":"agep","type":{"kind":"integer","sign":"unsigned","width":8},"visibility":"private"},{"name":"today","type":{"kind":"array","length":10,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},{"name":"age","type":{"kind":"integer","sign":"unsigned","width":8},"visibility":"public"}],"return_type":null,"error_types":{"2920182694213909827":{"error_kind":"string","string":"attempt to subtract with overflow"},"3506335684763995377":{"error_kind":"string","string":"Age does not match expected input."},"5050630712708838829":{"error_kind":"string","string":"Parsed value out of range"},"7175211918780786874":{"error_kind":"string","string":"Unsupported century"},"7848438624642765101":{"error_kind":"string","string":"Age verification has failed."},"8803417279912649565":{"error_kind":"string","string":"Year out of u8 bounds"},"14161288184972033825":{"error_kind":"string","string":"DOB is in the future"},"14391860526852903727":{"error_kind":"string","string":"Age out of u8 range"},"17176017143231868171":{"error_kind":"string","string":"Today's date does not match expected input."}}},"bytecode":"","debug_symbols":"","file_map":{"50":{"source":"fn parse_u8_pair(b1: u8, b2: u8) -> u8 {\n    let b1_field: Field = b1.into();\n    let b2_field: Field = b2.into();\n\n    let ten: Field = 10;\n    let forty_eight: Field = 48;\n\n    let result: Field = (b1_field - forty_eight) * ten + (b2_field - forty_eight);\n    assert(result as u8 < 100, \"Parsed value out of range\");\n\n    result as u8\n}\n\nfn parse_year(b1: u8, b2: u8, b3: u8, b4: u8) -> u8 {\n    let b1_f: Field = b1.into();\n    let b2_f: Field = b2.into();\n    let b3_f: Field = b3.into();\n    let b4_f: Field = b4.into();\n\n    let forty_eight = 48;\n    let ten = 10;\n    let hundred = 100;\n\n    let y1 = (b3_f - forty_eight) * ten + (b4_f - forty_eight); // last two digits\n    let century_check = (b1_f - forty_eight) * ten + (b2_f - forty_eight); // '19' or '20'\n\n    let year = if century_check == 19 {\n        y1\n    } else if century_check == 20 {\n        y1 + hundred\n    } else {\n        assert(false, \"Unsupported century\");\n        0.into() // dummy value for type safety\n    };\n\n    assert(year as u8 < 255, \"Year out of u8 bounds\");\n    year as u8\n}\n\nfn calculate_age(dob: [u8; 10], today: [u8; 10]) -> u8 {\n    let dob_day: u8 = parse_u8_pair(dob[0], dob[1]);\n    let dob_month: u8 = parse_u8_pair(dob[3], dob[4]);\n    let dob_year: u8 = parse_year(dob[6], dob[7], dob[8], dob[9]);\n\n    let today_day: u8 = parse_u8_pair(today[0], today[1]);\n    let today_month: u8 = parse_u8_pair(today[3], today[4]);\n    let today_year: u8 = parse_year(today[6], today[7], today[8], today[9]);\n\n    assert(today_year >= dob_year, \"DOB is in the future\");\n    let mut age: u8 = today_year - dob_year;\n\n    if (today_month < dob_month) | ((today_month == dob_month) & (today_day < dob_day)) {\n        age -= 1;\n    }\n\n    assert(age < 255, \"Age out of u8 range\");\n\n    age\n}\n\nfn main(dob: [u8; 10], todayp: [u8; 10], agep: u8, today: pub [u8; 10], age: pub u8) {\n    // First step: check that public inputs are correct\n    assert(today == todayp, \"Today's date does not match expected input.\");\n    assert(age == agep, \"Age does not match expected input.\");\n    // Second step: calculate age from today's date\n    let calculated_age: u8 = calculate_age(dob, today);\n    // Third step: check wether calculated ages is above the limit\n    assert(calculated_age >= age, \"Age verification has failed.\");\n}\n\n#[test]\nfn test_main() {\n    // Test that passes both hash and age verification\n    main(\n        [49, 54, 47, 48, 56, 47, 49, 57, 57, 57],\n        [50, 49, 47, 48, 55, 47, 50, 48, 50, 53],\n        20,\n        [50, 49, 47, 48, 55, 47, 50, 48, 50, 53],\n        21,\n    );\n}\n","path":"/Users/ribeiro/Repositories/DISSECT/verifiable-zkp/implementations/base/age/src/main.nr"}},"names":["main"],"brillig_names":["directive_integer_quotient","directive_invert"]}