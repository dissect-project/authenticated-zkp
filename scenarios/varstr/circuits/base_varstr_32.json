{"noir_version":"1.0.0-beta.7+24c053fba747770cf8d3f813d22cfa003714dfb6","hash":"1530308213467170879","abi":{"parameters":[{"name":"x","type":{"kind":"array","length":32,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"private"},{"name":"x_len","type":{"kind":"integer","sign":"unsigned","width":32},"visibility":"private"},{"name":"yp","type":{"kind":"array","length":8,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},{"name":"y","type":{"kind":"array","length":8,"type":{"kind":"integer","sign":"unsigned","width":8}},"visibility":"public"},{"name":"y_len","type":{"kind":"integer","sign":"unsigned","width":32},"visibility":"public"}],"return_type":null,"error_types":{"3382119026128644002":{"error_kind":"string","string":"String exceeds maximum size."},"3470247937022151081":{"error_kind":"string","string":"Substring exceeds maximum size."},"5019202896831570965":{"error_kind":"string","string":"attempt to add with overflow"},"6205006668095915909":{"error_kind":"string","string":"Public input y does not match expected value."},"16292203451551561274":{"error_kind":"string","string":"Substring verification has failed."}}},"bytecode":"","debug_symbols":"","file_map":{"50":{"source":"global MAX_STRSIZE: u32 = 32; // maximum string capacity\nglobal MAX_SUBSTRSIZE: u32 = 8; // maximum substring capacity\n\nfn contains(\n    string: [u8; MAX_STRSIZE],\n    string_len: u32,\n    substring: [u8; MAX_SUBSTRSIZE],\n    substring_len: u32,\n) -> bool {\n    let mut found = false;\n\n    for i in 0..(MAX_STRSIZE - MAX_SUBSTRSIZE + 1) {\n        if i + substring_len <= string_len {\n            let mut match_found = true;\n            for j in 0..MAX_SUBSTRSIZE {\n                if j < substring_len {\n                    if string[i + j] != substring[j] {\n                        match_found = false;\n                    }\n                }\n            }\n            if match_found {\n                found = true;\n            }\n        }\n    }\n\n    found\n}\n\nfn main(\n    x: [u8; MAX_STRSIZE],\n    x_len: u32,\n    yp: pub [u8; MAX_SUBSTRSIZE],\n    y: pub [u8; MAX_SUBSTRSIZE],\n    y_len: pub u32,\n) {\n    // First step: check that inputs do not exceed maximum sizes\n    assert(x_len <= MAX_STRSIZE, \"String exceeds maximum size.\");\n    assert(y_len <= MAX_SUBSTRSIZE, \"Substring exceeds maximum size.\");\n    // Second step: check that public inputs are correct\n    assert(y == yp, \"Public input y does not match expected value.\");\n    // Third step: check if x contains y\n    assert(contains(x, x_len, y, y_len), \"Substring verification has failed.\");\n}\n","path":"/Users/ribeiro/Repositories/DISSECT/verifiable-zkp/implementations/base/varstr/src/main.nr"}},"names":["main"],"brillig_names":["directive_integer_quotient","directive_invert"]}